# Provider keys stay in this file. It is gitignored. Leave them blank to run
# without a model: chat falls back to keyword routing and the saved demo answers.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
# Leave these blank for the local API (in-memory checklists, feedback, and updates).
# Docker Compose overrides them inside the containers.
DATABASE_URL=
QDRANT_URL=
QDRANT_API_KEY=
INTERNAL_TOKEN=
VITE_API_URL=http://127.0.0.1:8000
